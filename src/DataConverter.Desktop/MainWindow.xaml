<Window x:Class="DataConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Data Converter"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <DockPanel>
        <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="16,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.85"
                           Text="Drop a CSV, Excel or SQLite file anywhere to open it" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="Data Converter" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppDividerBrush}" Padding="16,8">
            <DockPanel>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="120" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" AutomationProperties.Name="Status" TextWrapping="Wrap" Text="Open a CSV or Excel file to start." />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8,8,8,0">
            <TabItem x:Name="ConvertTab" Header="CONVERT &amp; IMPORT">
                <Grid Margin="8,12,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button x:Name="OpenFileButton" DockPanel.Dock="Left" Content="OPEN FILE" Margin="0,0,12,0" Click="OpenFileButton_Click" />
                            <ComboBox x:Name="DelimiterPicker" DockPanel.Dock="Right" Width="140" Margin="12,0,0,0"
                                      AutomationProperties.Name="Delimiter" materialDesign:HintAssist.Hint="Delimiter"
                                      SelectionChanged="SourceOption_Changed" />
                            <ComboBox x:Name="SheetPicker" DockPanel.Dock="Right" Width="160" Margin="12,0,0,0"
                                      AutomationProperties.Name="Sheet" materialDesign:HintAssist.Hint="Sheet"
                                      SelectionChanged="SourceOption_Changed" />
                            <TextBlock x:Name="SourceText" AutomationProperties.Name="Source file" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Text="No file open" Foreground="{DynamicResource AppMutedBrush}" />
                        </DockPanel>
                        <TextBlock x:Name="SourceInfo" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource AppMutedBrush}" />
                        <DataGrid x:Name="PreviewGrid"
                                  AutomationProperties.AutomationId="PreviewGrid"
                                  AutomationProperties.Name="Preview"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  EnableRowVirtualization="True" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <materialDesign:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Save as" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="Plain numbers become number cells; values like 007 stay text." TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,12" />
                                    <Button x:Name="SaveExcelButton" Content="SAVE AS EXCEL" IsEnabled="False" Margin="0,0,0,8" Click="SaveExcelButton_Click" />
                                    <DockPanel>
                                        <ComboBox x:Name="OutputDelimiterPicker" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                                                  AutomationProperties.Name="CSV delimiter" />
                                        <Button x:Name="SaveCsvButton" Content="SAVE AS CSV" IsEnabled="False"
                                                Style="{DynamicResource MaterialDesignOutlinedButton}" Click="SaveCsvButton_Click" />
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Import into SQLite" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBox x:Name="TableNameInput" AutomationProperties.Name="Table name" materialDesign:HintAssist.Hint="Table name"
                                             materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,12" />
                                    <ComboBox x:Name="SplitPicker" AutomationProperties.Name="Split by column" materialDesign:HintAssist.Hint="One table per value of"
                                              materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,12" />
                                    <ComboBox x:Name="IfExistsPicker" AutomationProperties.Name="If the table exists" materialDesign:HintAssist.Hint="If the table already exists"
                                              materialDesign:HintAssist.IsFloating="True" Margin="0,0,0,12" />
                                    <CheckBox x:Name="InferTypesInput" Content="Detect number columns" IsChecked="True" Margin="0,0,0,12" />
                                    <Button x:Name="ImportButton" Content="IMPORT INTO DATABASE" IsEnabled="False" Click="ImportButton_Click" />
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="BrowseTab" Header="BROWSE DATABASE">
                <Grid Margin="8,12,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Button x:Name="OpenDatabaseButton" DockPanel.Dock="Top" Content="OPEN DATABASE" Margin="0,0,0,8" Click="OpenDatabaseButton_Click" />
                        <TextBlock x:Name="DatabaseText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                                   AutomationProperties.Name="Database file" Text="No database open" Foreground="{DynamicResource AppMutedBrush}" />
                        <ListBox x:Name="TableList" AutomationProperties.Name="Tables" SelectionChanged="TableList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Rows}" Foreground="{DynamicResource AppMutedBrush}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button x:Name="ExportCsvButton" DockPanel.Dock="Right" Content="EXPORT CSV" IsEnabled="False"
                                    Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="8,0,0,0" Click="ExportCsvButton_Click" />
                            <Button x:Name="ExportExcelButton" DockPanel.Dock="Right" Content="EXPORT EXCEL" IsEnabled="False" Click="ExportExcelButton_Click" />
                            <TextBlock x:Name="TableTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="TableInfo" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource AppMutedBrush}" />
                        <DataGrid x:Name="TableGrid"
                                  AutomationProperties.AutomationId="TableGrid"
                                  AutomationProperties.Name="Table rows"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  EnableRowVirtualization="True" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
